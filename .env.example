# Never commit real values (.env is in .gitignore).
#
# SERVER (Render) needs: SECRET_KEY, DATABASE_URL, ADMIN_PASSWORD, PYTHON_VERSION
# BOT (Termux) needs:    BOT_TOKEN, ADMIN_IDS, DATABASE_URL
# The Telegram lines below (API_ID ... CHANNEL_ID) are OPTIONAL: only for files kept
# in a private Telegram channel. Direct video links do not need them.

# From https://my.telegram.org -> API development tools
API_ID=0
API_HASH=

# Run gen_session.py once on your phone/PC and paste the output here.
SESSION_STRING=

# From @BotFather
BOT_TOKEN=

# Your private storage channel id, like -1001234567890
CHANNEL_ID=0

# Your Telegram user id (ask @userinfobot). Several ids: 111,222
ADMIN_IDS=

# Any long random text. Used to sign app tokens.
SECRET_KEY=

# Free Postgres from Supabase or Neon. Render's disk is wiped on restart,
# so do not use the default SQLite there. If the bot runs on your own phone/PC,
# it must use this SAME DATABASE_URL as the server.
DATABASE_URL=

# Password for the admin panel inside the app. Make it long and unique.
ADMIN_PASSWORD=


# Render only: use a stable Python
PYTHON_VERSION=3.12.7
